# RAG 智能助手 —— 环境变量模板
#
# 用法：copy .env.example .env  然后按需填写真实值。
# 未填写的项 = 对应功能不启用（系统会降级，不会崩）。
# .env 已在 .gitignore 中，不会被提交。

# ═══════════════════════════════════════════════
# 必填：LLM（不填则对话不可用）
# ═══════════════════════════════════════════════
GROQ_API_KEY=

# ═══════════════════════════════════════════════
# 工具：按需填，不填则对应工具不可用
# ═══════════════════════════════════════════════
OPENWEATHER_API_KEY=          # 天气查询
EDU_STUDENT_ID=               # 河海大学教务
EDU_PASSWORD=
BAIDU_OCR_API_KEY=            # 公式识别（主通道）
BAIDU_OCR_SECRET_KEY=
SIMPLETEX_API_KEY=            # 公式识别（备选通道）

# ═══════════════════════════════════════════════
# 安全（生产环境务必覆盖）
# ═══════════════════════════════════════════════
KB_PERMISSION_SECRET_KEY=     # JWT 签名密钥，留空则用代码内默认值（仅适合本地）

# ═══════════════════════════════════════════════
# 告警（可选）：熔断打开时推送到钉钉/飞书机器人
# ═══════════════════════════════════════════════
ALERT_WEBHOOK_URL=

# ═══════════════════════════════════════════════
# 模型覆盖（可选，一般不用填）
#   留空则用 config.py 的默认值（LLM_MODEL / JUDGE_MODEL）
# ═══════════════════════════════════════════════
# LLM_MODEL=deepseek-v4-flash
# JUDGE_MODEL=deepseek-v4-flash       # 独立 Judge 判定模型，可换更小的模型

# ═══════════════════════════════════════════════
# 可观测（可选）：需先起 LangFuse，并在 config.py 设 LANGFUSE_ENABLED=True
#   docker compose -f docker-compose.langfuse.yml up -d
# ═══════════════════════════════════════════════
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ═══════════════════════════════════════════════
# 服务地址
#   ⚠️ Docker 下 docker-compose.yml 已自动注入以下各项，无需在此重复填写
#   ⚠️ 本地开发启动时才需要（见 技术文档/启动指南.md 第八节）
# ═══════════════════════════════════════════════
# EMBED_SERVER_URL=http://localhost:8001     # 留空 = 主进程内嵌加载模型
# RERANK_SERVER_URL=http://localhost:8002    # 留空 = 主进程内嵌加载模型
# CHROMA_SERVER_URL=http://localhost:8100    # ⚠️ 用 8100，8000 已被 api-server 占用；留空 = 本地向量库
# REDIS_HOST=localhost
# REDIS_PORT=6379
# API_SERVER_URL=http://localhost:8000       # 前端登录请求的权限后端地址

# ═══════════════════════════════════════════════
# 运行产物目录（Docker 持久化用，一般不用手填）
#   留空 = 审计/Token/问答日志/告警/长期记忆库 用各自默认位置
#   设置 = 统一落到该目录（docker-compose 已注入 /app/runtime_data 并挂载宿主机）
# ═══════════════════════════════════════════════
# RUNTIME_DATA_DIR=
